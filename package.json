{
  "name": "my-app",
  "version": "0.1.0",
  "homepage": "https://github.com/Soapheart/taskTracker",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "nanoid": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sass": "^1.77.6",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "bun run --bun react-scripts start",
    "build": "bun run --bun react-scripts build",
    "test": "bun run --bun react-scripts test",
    "type-check": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  },
  "module": "src/index.js",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
